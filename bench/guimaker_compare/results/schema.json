{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GUIMaker comparison run (Phase 9D)",
  "type": "object",
  "required": ["library", "run"],
  "properties": {
    "library": {
      "type": "string",
      "enum": [
        "guimaker",
        "egui",
        "egui-wgpu",
        "iced",
        "slint",
        "imgui",
        "webview2",
        "floor-wgpu-vulkan",
        "floor-wgpu-dx12",
        "floor-wgpu-gl",
        "floor-glow"
      ]
    },
    "run": { "type": "integer", "minimum": 1 },
    "session_id": { "type": "string" },
    "measured_at": { "type": "string" },
    "reason": { "type": "string" },
    "winner": { "type": ["string", "null"] },
    "scenario": { "type": "string" },
    "tier": { "type": "string", "enum": ["vulkan", "dx12", "gl"] },
    "floor": { "type": "boolean" },
    "mode": { "type": "string" },
    "startup_ms": { "type": ["number", "null"], "minimum": 0 },
    "startup_ms_self": { "type": ["number", "null"], "minimum": 0 },
    "startup_source": { "type": "string" },
    "idle_cpu_pct": { "type": "number", "minimum": 0 },
    "tail_cpu_pct": { "type": "number", "minimum": 0 },
    "hover_cpu_pct": { "type": ["number", "null"], "minimum": 0 },
    "typing_cpu_pct": { "type": ["number", "null"], "minimum": 0 },
    "button_cpu_pct": { "type": ["number", "null"], "minimum": 0 },
    "typing_chars": { "type": "integer", "minimum": 0 },
    "bench_text_chars": { "type": ["integer", "null"], "minimum": 0 },
    "frames": { "type": ["integer", "null"], "minimum": 0 },
    "idle_frames": { "type": ["integer", "null"], "minimum": 0 },
    "frames_external": { "type": ["integer", "null"], "minimum": 0 },
    "frames_self": { "type": ["integer", "null"], "minimum": 0 },
    "frames_source": { "type": "string" },
    "top_threads_cpu": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tid": { "type": "integer" },
          "name": { "type": "string" },
          "module": { "type": "string" },
          "kind": { "type": "string" },
          "display": { "type": "string" },
          "cpu_seconds": { "type": "number" },
          "cpu_pct": { "type": "number" },
          "wakeups_per_s": { "type": ["number", "null"] }
        }
      }
    },
    "thread_names": { "type": "object", "additionalProperties": { "type": "string" } },
    "tail_top_thread": { "type": ["string", "null"] },
    "wakeups_per_s": { "type": ["number", "null"], "minimum": 0 },
    "wakeups_source": { "type": "string" },
    "gpu_bytes": { "type": "integer", "minimum": 0 },
    "gpu_source": { "type": "string" },
    "rss_bytes": { "type": "integer", "minimum": 0 },
    "binary_bytes": { "type": "integer", "minimum": 0 },
    "wall_seconds": { "type": "number", "minimum": 0 },
    "hover_moves": { "type": "integer", "minimum": 0 },
    "ui_thread_id": { "type": ["integer", "null"] },
    "ui_thread_cpu_seconds": { "type": ["number", "null"] },
    "pixel_diff": {
      "type": "object",
      "properties": {
        "comparable": { "type": "boolean" },
        "note": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "sampled_pixels": { "type": "integer" },
        "mean_abs_channel_diff": { "type": "number" },
        "changed_pixel_ratio": { "type": "number" }
      }
    },
    "capture_ok": { "type": "boolean" },
    "capture_nonblack_ratio": { "type": ["number", "null"] },
    "backend": { "type": "string" },
    "present_mode": { "type": "string" },
    "present_source": { "type": "string" },
    "fonts": { "type": "string", "enum": ["roboto", "default"] },
    "versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "memory": { "type": ["object", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "source_warning": { "type": "string" },
    "error": { "type": "string" },
    "features": {
      "type": "object",
      "properties": {
        "cjk": { "type": "boolean" },
        "emoji": { "type": "boolean" },
        "popups_outside_window": { "type": "boolean" },
        "per_monitor_dpi": { "type": "boolean" },
        "ime": { "type": "boolean" }
      }
    }
  }
}
